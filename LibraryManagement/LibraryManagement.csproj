<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>LibraryManagement.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Dapper" Version="2.1.24" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\FormLogin.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FormMain.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FormBookManagement.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FormMemberManagement.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FormBorrow.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FormReturn.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FormReport.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FormSettings.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FormBookDetailPublic.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FormBorrowHistory.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FormConnectionConfig.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FormPayFine.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FormRenewBook.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FormBookDetailPublic.Designer.cs">
      <DependentUpon>FormBookDetailPublic.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\FormBorrowHistory.Designer.cs">
      <DependentUpon>FormBorrowHistory.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\FormConnectionConfig.Designer.cs">
      <DependentUpon>FormConnectionConfig.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\FormPayFine.Designer.cs">
      <DependentUpon>FormPayFine.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\FormRenewBook.Designer.cs">
      <DependentUpon>FormRenewBook.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Forms\FormBookDetailPublic.resx">
      <DependentUpon>FormBookDetailPublic.cs</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="Forms\FormBorrowHistory.resx">
      <DependentUpon>FormBorrowHistory.cs</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="Forms\FormConnectionConfig.resx">
      <DependentUpon>FormConnectionConfig.cs</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="Forms\FormPayFine.resx">
      <DependentUpon>FormPayFine.cs</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="Forms\FormRenewBook.resx">
      <DependentUpon>FormRenewBook.cs</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
